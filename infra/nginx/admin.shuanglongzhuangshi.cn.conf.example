# Phase 1C template. Review paths and upstream ports in staging before production use.
# This file contains no certificate keys, OSS credentials, or application secrets.

log_format shuanglong_privacy '$remote_addr - $remote_user [$time_local] '
    '"$request_method $uri $server_protocol" $status $body_bytes_sent '
    '"$http_user_agent" request_time=$request_time';

upstream shuanglong_api {
    server 127.0.0.1:3001;
    keepalive 32;
}

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    access_log off;
    return 444;
}

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
    access_log off;
}

server {
    listen 80;
    listen [::]:80;
    server_name admin.shuanglongzhuangshi.cn;
    access_log /var/log/nginx/shuanglong-admin.access.log shuanglong_privacy;

    location /.well-known/acme-challenge/ {
        root /var/www/acme;
    }

    location / {
        return 301 https://admin.shuanglongzhuangshi.cn$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name admin.shuanglongzhuangshi.cn;

    ssl_certificate /etc/nginx/tls/admin.shuanglongzhuangshi.cn/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/admin.shuanglongzhuangshi.cn/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache shared:TLS:10m;
    ssl_session_tickets off;

    # Enable only after HTTPS is proven for this host and every covered subdomain.
    # add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    client_max_body_size 10m;
    access_log /var/log/nginx/shuanglong-admin.access.log shuanglong_privacy;
    error_log /var/log/nginx/shuanglong-admin.error.log warn;

    location = /api/health {
        proxy_pass http://shuanglong_api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 2s;
        proxy_read_timeout 5s;
    }

    location /api/ {
        proxy_pass http://shuanglong_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }

    location / {
        root /srv/shuanglong/web/current;
        try_files $uri $uri/ /index.html;
    }
}
