[Unit]
Description=Run queued management Agent request
After=network-online.target postgresql.service shuanglong-management-api.service
Wants=network-online.target

[Service]
Type=oneshot
TimeoutStartSec=180
User=root
Group=root
WorkingDirectory=/opt/wecom-chat-pipeline
EnvironmentFile=/etc/wecom-chat-pipeline/secrets.env
EnvironmentFile=/etc/shuanglong-management/api.env
Environment=MANAGEMENT_API_BASE_URL=http://127.0.0.1:3001
Environment=MANAGEMENT_AGENT_REVIEW_SCRIPT=/opt/shuanglong-management/current/apps/agent-worker/dist/chat-review.cjs
Environment=WECOM_PIPELINE_ROOT=/opt/wecom-chat-pipeline
ExecStart=/usr/bin/node /opt/shuanglong-management/current/apps/agent-worker/dist/agent-dispatcher.cjs
NoNewPrivileges=true
PrivateTmp=true
