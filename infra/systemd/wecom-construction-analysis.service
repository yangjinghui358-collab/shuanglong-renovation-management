[Unit]
Description=Analyze WeCom construction progress messages
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/wecom-chat-pipeline
EnvironmentFile=/etc/wecom-chat-pipeline/secrets.env
ExecStart=/usr/bin/node /opt/wecom-chat-pipeline/scripts/analyze-construction-progress.mjs
NoNewPrivileges=true
PrivateTmp=true

