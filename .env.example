# Local SSH tunnel endpoint. Supply real credentials only in an ignored .env.
WECOM_DATABASE_URL=postgresql://readonly_user@127.0.0.1:15432/wecom_chat
MANAGEMENT_DATABASE_URL=postgresql://management_user@127.0.0.1:15432/wecom_chat
ADMIN_PHONE=replace_with_owner_mobile
ADMIN_INITIAL_PASSWORD=replace_with_a_random_password_of_12_or_more_characters
AGENT_INGEST_TOKEN=replace_with_a_random_token_of_24_or_more_characters
