# 本地验收使用 mock；正式环境改为 command。
ARCHIVE_PROVIDER=mock
MOCK_ARCHIVE_FILE=fixtures/messages.json
WECOM_ARCHIVE_COMMAND=
WECOM_CORP_ID=
WECOM_ARCHIVE_SECRET=
WECOM_CONTACT_SYNC_ENABLED=false
# 企业微信通讯录/客户联系应用 Secret；仅在应用具有相应读取权限时启用。
WECOM_CONTACT_SECRET=
WECOM_FINANCE_CLI=/opt/wecom-sdk/bin/wecom-finance-cli
WECOM_PRIVATE_KEY_FILE=/etc/wecom-chat-pipeline/archive_private_key.pem

# 本地使用 sqlite；腾讯云生产环境改为 cloudbase。
DATABASE_DRIVER=sqlite
DATABASE_PATH=data/wecom-chat.db
CLOUDBASE_ENV_ID=
# 在云托管/云函数内自动读取身份；自建服务器使用环境变量配置 API Key。
CLOUDBASE_APIKEY=
GROUP_ID=demo-group-01
GROUP_NAME=测试客户群
TIMEZONE=Asia/Shanghai

# 每分钟轮询一次，22:05 生成前一天 22:00 至当天 22:00 的简报。
POLL_INTERVAL_SECONDS=60
DIGEST_HOUR=22
DIGEST_MINUTE=5
DIGEST_CUTOFF_HOUR=22

# 留空时使用本地规则提取器；配置后调用 OpenAI 兼容接口。
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
